# ─────────────────────────────────────────────────────────────
# Northstar — Career Counsellor Agent
# Copy to .env.local and fill in what you have. Everything except
# AUTH_SECRET is optional: the app runs in a fully seeded local
# demo mode with no external services.
# ─────────────────────────────────────────────────────────────

# 32+ character secret used to sign session cookies.
# Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public base URL used in QR verification links inside the PDF report.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Data ─────────────────────────────────────────────────────
# "file" (default) uses a local JSON store at .data/db.json.
# "supabase" uses Postgres through the Supabase service role.
DATA_BACKEND=file

# Optional: move the local JSON store outside the project directory.
# NORTHSTAR_DATA_DIR=

# Only required when DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres connection, only for `npm run supabase:apply`.
# Project Settings → Database → Connection string → URI.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── AI advisor ───────────────────────────────────────────────
# The model client is isolated in lib/ai/gemini.ts. Without a key
# the advisor falls back to a deterministic, rule-based counsellor
# so the product still works end to end.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional override, e.g. a proxy.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
